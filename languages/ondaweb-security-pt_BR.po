#: includes/security/class-owsu-admin.php:533
#: includes/security/class-owsu-admin.php:624
msgid "no fix"
msgstr "sem correção"

#: includes/security/class-owsu-admin.php:547
msgid "Run a check first."
msgstr "Execute uma verificação primeiro."

#: includes/security/class-owsu-admin.php:556
msgid "Technical security report"
msgstr "Relatório técnico de segurança"

#: includes/security/class-owsu-admin.php:571
msgid "Internal document — do not forward to the client."
msgstr "Documento interno — não encaminhar ao cliente."

#: includes/security/class-owsu-admin.php:573
msgid "CONFIDENTIAL – INTERNAL USE"
msgstr "CONFIDENCIAL – USO INTERNO"

#. translators: %s: client name
#: includes/security/class-owsu-admin.php:574
msgid "Technical security report — %s"
msgstr "Relatório técnico de segurança — %s"

#. translators: 1: date and time, 2: site address, 3: score, 4: grade, 5:
#. critical count, 6: warning count, 7: OK count
#: includes/security/class-owsu-admin.php:579
msgid ""
"Check of %1$s · %2$s · Score %3$d/100 (%4$s) · %5$d critical, %6$d warning, "
"%7$d OK"
msgstr ""
"Verificação de %1$s · %2$s · Nota %3$d/100 (%4$s) · %5$d críticos, %6$d "
"atenção, %7$d OK"

#. translators: %s: date
#: includes/security/class-owsu-admin.php:607
msgid "fix applied on %s"
msgstr "correção aplicada em %s"

#: includes/security/class-owsu-admin.php:622
msgid "Vulnerability details"
msgstr "Detalhe das vulnerabilidades"

#: includes/security/class-owsu-admin.php:622
msgid "Recommendation"
msgstr "Recomendação"

#: includes/security/class-owsu-admin.php:626
msgid "Source: Wordfence Intelligence (Defiant, Inc.)."
msgstr "Fonte: Wordfence Intelligence (Defiant, Inc.)."

#: includes/security/class-owsu-areas.php:18
msgid "Security headers"
msgstr "Cabeçalhos de segurança"

#: includes/security/class-owsu-areas.php:19
msgid ""
"Instructions the server sends to the browser: mandatory HTTPS, blocking "
"display inside third-party pages and rules for loading content."
msgstr ""
"Instruções que o servidor envia ao navegador: uso obrigatório de HTTPS, "
"bloqueio de exibição em páginas de terceiros e regras para o carregamento de"
" conteúdo."

#: includes/security/class-owsu-areas.php:20
msgid ""
"Instructions sent by the server with every response, telling the visitor's "
"browser to treat the site more safely."
msgstr ""
"Instruções enviadas pelo servidor em cada resposta, que orientam o navegador"
" do visitante a tratar o site de forma mais segura."

#: includes/security/class-owsu-areas.php:21
msgid ""
"Interception of data in transit, use of the site inside fake pages and "
"execution of unauthorized content in the visitor's browser."
msgstr ""
"Interceptação de dados em trânsito, uso do site dentro de páginas falsas e "
"execução de conteúdo não autorizado no navegador do visitante."

#: includes/security/class-owsu-areas.php:23
msgid "HSTS (mandatory HTTPS)"
msgstr "HSTS (HTTPS obrigatório)"

#: includes/security/class-owsu-areas.php:23
msgid ""
"the browser only accesses the site over an encrypted connection, even if the"
" visitor types the address without https."
msgstr ""
"o navegador passa a acessar o site somente por conexão criptografada, mesmo "
"que o visitante digite o endereço sem https."

#: includes/security/class-owsu-areas.php:24
msgid "Clickjacking protection"
msgstr "Proteção contra clickjacking"

#: includes/security/class-owsu-areas.php:24
msgid ""
"prevents the site from being shown inside third-party pages to trick "
"visitors into clicking without noticing."
msgstr ""
"impede que o site seja exibido dentro de páginas de terceiros para induzir "
"cliques sem que o visitante perceba."

#: includes/security/class-owsu-areas.php:25
msgid "Nosniff"
msgstr "Nosniff"

#: includes/security/class-owsu-areas.php:25
msgid ""
"the browser respects the file type stated by the server and does not try to "
"interpret a file as another format."
msgstr ""
"o navegador respeita o tipo de arquivo informado pelo servidor e não tenta "
"interpretar um arquivo como outro formato."

#: includes/security/class-owsu-areas.php:26
msgid "Referrer policy"
msgstr "Política de referência"

#: includes/security/class-owsu-areas.php:26
msgid ""
"limits the browsing information passed on to other sites when the visitor "
"clicks an external link."
msgstr ""
"limita as informações de navegação repassadas a outros sites quando o "
"visitante clica em um link externo."

#: includes/security/class-owsu-areas.php:27
msgid "Permissions policy"
msgstr "Política de permissões"

#: includes/security/class-owsu-areas.php:27
msgid "restricts the use of browser features by the site's pages."
msgstr "restringe o uso de recursos do navegador pelas páginas do site."

#: includes/security/class-owsu-areas.php:28
msgid "Structural Content Security Policy (CSP)"
msgstr "Política de segurança de conteúdo (CSP) estrutural"

#: includes/security/class-owsu-areas.php:28
msgid ""
"sets rules for the content the page can load, reducing the room for code "
"injection."
msgstr ""
"define regras para o conteúdo que a página pode carregar, reduzindo o espaço"
" para injeção de código."

#: includes/security/class-owsu-areas.php:33
msgid "Administrative access"
msgstr "Acesso administrativo"

#: includes/security/class-owsu-areas.php:34
msgid ""
"WordPress login screen and dashboard: access address, barriers against bots,"
" attempt limit and a second authentication step."
msgstr ""
"Tela de login e painel do WordPress: endereço de acesso, barreiras contra "
"robôs, limite de tentativas e segunda etapa de autenticação."

#: includes/security/class-owsu-areas.php:35
msgid ""
"Layers of protection around the WordPress dashboard, the most targeted point"
" in automated intrusion attempts."
msgstr ""
"Camadas de proteção em torno do painel do WordPress, o ponto mais visado em "
"tentativas automáticas de invasão."

#: includes/security/class-owsu-areas.php:36
msgid ""
"Improper access to the dashboard through brute force, leaked passwords or "
"automation against the default login address."
msgstr ""
"Acesso indevido ao painel por força bruta, por senhas vazadas ou por "
"automação contra o endereço padrão de login."

#: includes/security/class-owsu-areas.php:38
#: includes/security/class-owsu-security.php:352
msgid "Custom login address"
msgstr "Endereço de login personalizado"

#: includes/security/class-owsu-areas.php:38
msgid ""
"the access screen is no longer at the default WordPress address, the first "
"target of bots."
msgstr ""
"a tela de acesso deixa de estar no endereço padrão do WordPress, que é o "
"primeiro alvo de robôs."

#: includes/security/class-owsu-areas.php:39
msgid ""
"<code>/wp-login.php</code> and <code>/wp-admin</code> blocked for visitors"
msgstr ""
"Bloqueio de <code>/wp-login.php</code> e <code>/wp-admin</code> para "
"visitantes"

#: includes/security/class-owsu-areas.php:39
msgid "the default addresses do not answer anyone who is not logged in."
msgstr "os endereços padrão não respondem para quem não está autenticado."

#: includes/security/class-owsu-areas.php:40
msgid "makes access attempts by automated scripts harder."
msgstr "dificulta tentativas de acesso feitas por scripts automatizados."

#: includes/security/class-owsu-areas.php:41
msgid "Attempt limit"
msgstr "Limite de tentativas"

#: includes/security/class-owsu-areas.php:41
msgid "stops sequences of password trial and error (brute force)."
msgstr "interrompe sequências de tentativa e erro de senha (força bruta)."

#: includes/security/class-owsu-areas.php:42
msgid "Two-factor authentication"
msgstr "Autenticação em dois fatores"

#: includes/security/class-owsu-areas.php:42
msgid ""
"besides the password, access requires a second confirmation; a leaked "
"password alone does not open the dashboard."
msgstr ""
"além da senha, o acesso exige uma segunda confirmação; uma senha vazada, "
"sozinha, não abre o painel."

#: includes/security/class-owsu-areas.php:43
msgid "Dashboard over HTTPS only"
msgstr "Painel somente em HTTPS"

#: includes/security/class-owsu-areas.php:43
msgid "username and password always travel encrypted."
msgstr "usuário e senha sempre trafegam criptografados."

#: includes/security/class-owsu-areas.php:44
msgid "No predictable login"
msgstr "Sem login previsível"

#: includes/security/class-owsu-areas.php:44
msgid ""
"there is no administrator with the \"admin\" login, the first one tried by "
"bots."
msgstr "não há administrador com o login \"admin\", o primeiro testado por robôs."

#: includes/security/class-owsu-areas.php:49
msgid "Protection against user enumeration"
msgstr "Proteção contra enumeração de usuários"

#: includes/security/class-owsu-areas.php:50
msgid ""
"Points of the site that could reveal login names: REST API, author lookup "
"and sitemaps."
msgstr ""
"Pontos do site que poderiam revelar nomes de login: API REST, consulta por "
"autor e sitemaps."

#: includes/security/class-owsu-areas.php:51
msgid ""
"Enumerating users means discovering a site's login names. With the name in "
"hand, the attacker already has half of the credential."
msgstr ""
"Enumerar usuários é descobrir os nomes de login de um site. Com o nome em "
"mãos, o atacante já tem metade da credencial."

#: includes/security/class-owsu-areas.php:52
msgid ""
"Collection of usernames to aim password attacks and phishing attempts at the"
" team."
msgstr ""
"Coleta de nomes de usuário para direcionar ataques de senha e tentativas de "
"phishing contra a equipe."

#: includes/security/class-owsu-areas.php:54
msgid "REST API"
msgstr "API REST"

#: includes/security/class-owsu-areas.php:54
msgid "the user listing was blocked in the WordPress data interface."
msgstr ""
"a listagem de usuários foi bloqueada na interface de dados do WordPress."

#: includes/security/class-owsu-areas.php:55
msgid "<code>?author=</code> address"
msgstr "Endereço <code>?author=</code>"

#: includes/security/class-owsu-areas.php:55
msgid ""
"the lookup that revealed the login name from the author number no longer "
"answers."
msgstr ""
"a consulta que revelava o nome de login pelo número do autor não responde "
"mais."

#: includes/security/class-owsu-areas.php:56
msgid "Sitemaps"
msgstr "Sitemaps"

#: includes/security/class-owsu-areas.php:56
msgid "the authors sitemap was removed."
msgstr "o sitemap de autores foi removido."

#: includes/security/class-owsu-areas.php:61
#: includes/security/class-owsu-security.php:304
msgid "XML-RPC"
msgstr "XML-RPC"

#: includes/security/class-owsu-areas.php:62
msgid ""
"Old WordPress remote communication interface, disabled because it is a "
"channel widely used in password attacks."
msgstr ""
"Interface antiga de comunicação remota do WordPress, desativada por ser um "
"canal muito usado em ataques de senha."

#: includes/security/class-owsu-areas.php:63
msgid ""
"Old WordPress remote communication interface, rarely used today and often "
"exploited."
msgstr ""
"Interface antiga de comunicação remota do WordPress, hoje pouco utilizada e "
"frequentemente explorada."

#: includes/security/class-owsu-areas.php:64
msgid "Mass brute force and abuse of the channel for overload attacks."
msgstr "Força bruta em massa e abuso do canal para ataques de sobrecarga."

#: includes/security/class-owsu-areas.php:66
msgid "Interface disabled"
msgstr "Interface desativada"

#: includes/security/class-owsu-areas.php:66
msgid ""
"the site no longer accepts requests through this channel, which allows "
"testing many passwords in a single call and can be used to overload the "
"site."
msgstr ""
"o site deixa de aceitar requisições por esse canal, que permite testar "
"muitas senhas em uma única chamada e pode ser usado para sobrecarregar o "
"site."

#: includes/security/class-owsu-areas.php:71
msgid "Less exposed information"
msgstr "Redução de informações expostas"

#: includes/security/class-owsu-areas.php:72
msgid ""
"Technical data visible to any visitor: WordPress version and server "
"technology."
msgstr ""
"Dados técnicos visíveis a qualquer visitante: versão do WordPress e "
"tecnologia do servidor."

#: includes/security/class-owsu-areas.php:73
msgid ""
"The less the site reveals about what is installed, the harder it is to look "
"for known flaws of a specific version."
msgstr ""
"Quanto menos o site revela sobre o que está instalado, mais difícil é "
"procurar falhas conhecidas para uma versão específica."

#: includes/security/class-owsu-areas.php:74
msgid ""
"Mapping of the environment by scanning tools, which match exposed versions "
"against public flaws."
msgstr ""
"Mapeamento do ambiente por ferramentas de varredura, que cruzam versões "
"expostas com falhas públicas."

#: includes/security/class-owsu-areas.php:76
msgid "WordPress version removed from the page source"
msgstr "Versão do WordPress removida do código-fonte"

#: includes/security/class-owsu-areas.php:76
msgid ""
"the generator meta tag, which stated the exact version, was removed from the"
" pages."
msgstr ""
"foi retirado das páginas o meta generator, que informava a versão exata."

#: includes/security/class-owsu-areas.php:77
msgid "<code>X-Powered-By</code> header removed"
msgstr "Cabeçalho <code>X-Powered-By</code> removido"

#: includes/security/class-owsu-areas.php:77
msgid "the server no longer states the technology in use."
msgstr "o servidor não informa mais a tecnologia utilizada."

#: includes/security/class-owsu-areas.php:82
msgid "Files and folders"
msgstr "Arquivos e pastas"

#: includes/security/class-owsu-areas.php:83
msgid ""
"Uploads folder, directory listing, sensitive files and permissions of the "
"configuration file."
msgstr ""
"Pasta de uploads, listagem de diretórios, arquivos sensíveis e permissões do"
" arquivo de configuração."

#: includes/security/class-owsu-areas.php:84
msgid ""
"Server rules that prevent running and reading files that should not be "
"reachable from the internet."
msgstr ""
"Regras no servidor que impedem a execução e a leitura de arquivos que não "
"deveriam estar acessíveis pela internet."

#: includes/security/class-owsu-areas.php:85
msgid ""
"Execution of code sent by upload, leakage of credentials, backups and "
"internal information about the environment."
msgstr ""
"Execução de código enviado por upload, vazamento de credenciais, de backups "
"e de informações internas do ambiente."

#: includes/security/class-owsu-areas.php:87
msgid "PHP execution blocked in uploads"
msgstr "Execução de PHP bloqueada em uploads"

#: includes/security/class-owsu-areas.php:87
msgid ""
"even if a malicious file is sent to the media folder, it is not executed."
msgstr ""
"mesmo que um arquivo malicioso seja enviado à pasta de mídia, ele não é "
"executado."

#: includes/security/class-owsu-areas.php:88
msgid "Directory listing disabled"
msgstr "Listagem de diretórios desativada"

#: includes/security/class-owsu-areas.php:88
msgid "the content of the folders cannot be browsed through the address."
msgstr "o conteúdo das pastas não pode ser navegado pelo endereço."

#: includes/security/class-owsu-areas.php:89
msgid "Sensitive files blocked"
msgstr "Arquivos sensíveis bloqueados"

#: includes/security/class-owsu-areas.php:89
msgid ""
"<code>.env</code>, <code>.git</code>, backups, logs, readme and license are "
"not delivered to visitors."
msgstr ""
"<code>.env</code>, <code>.git</code>, backups, logs, readme e license não "
"são entregues a visitantes."

#: includes/security/class-owsu-areas.php:90
msgid "Restricted permission on <code>wp-config.php</code>"
msgstr "Permissão restrita no <code>wp-config.php</code>"

#: includes/security/class-owsu-areas.php:90
msgid ""
"the file with the database credentials is limited to the owner and group on "
"the server."
msgstr ""
"o arquivo com as credenciais do banco de dados fica restrito ao dono e ao "
"grupo do servidor."

#: includes/security/class-owsu-areas.php:91
msgid "No world-writable permissions"
msgstr "Sem permissões de escrita liberadas para todos"

#: includes/security/class-owsu-areas.php:91
msgid "folders and files cannot be changed by other processes on the server."
msgstr ""
"pastas e arquivos não podem ser alterados por outros processos do servidor."

#: includes/security/class-owsu-areas.php:92
msgid "Uploads folder free of scripts"
msgstr "Pasta de uploads sem scripts"

#: includes/security/class-owsu-areas.php:92
msgid "a full scan confirms there are no PHP files among the uploaded files."
msgstr ""
"a varredura completa confirma que não há arquivos PHP entre os arquivos "
"enviados."

#: includes/security/class-owsu-areas.php:97
#: includes/security/class-owsu-security.php:86
msgid "WordPress configuration"
msgstr "Configuração do WordPress"

#: includes/security/class-owsu-areas.php:98
msgid ""
"Internal system settings: file editor, error display, security keys and "
"automatic updates."
msgstr ""
"Ajustes internos do sistema: editor de arquivos, exibição de erros, chaves "
"de segurança e atualizações automáticas."

#: includes/security/class-owsu-areas.php:99
msgid ""
"Internal settings that limit the damage of a compromised account and keep "
"the system core up to date."
msgstr ""
"Ajustes internos que limitam o estrago de uma conta comprometida e mantêm o "
"núcleo do sistema atualizado."

#: includes/security/class-owsu-areas.php:100
msgid ""
"Code changed from a hijacked account, exposure of internal details and flaws"
" that were already fixed staying in place."
msgstr ""
"Alteração de código a partir de uma conta invadida, exposição de detalhes "
"internos e permanência de falhas já corrigidas."

#: includes/security/class-owsu-areas.php:102
msgid "Dashboard file editor disabled"
msgstr "Editor de arquivos do painel desativado"

#: includes/security/class-owsu-areas.php:102
msgid ""
"the code of themes and plugins cannot be changed from inside the dashboard."
msgstr ""
"o código de temas e plugins não pode ser alterado por dentro do painel."

#: includes/security/class-owsu-areas.php:103
msgid "Error display disabled"
msgstr "Exibição de erros desativada"

#: includes/security/class-owsu-areas.php:103
msgid ""
"technical messages, which reveal paths and internal details, are not shown "
"to visitors."
msgstr ""
"mensagens técnicas, que revelam caminhos e detalhes internos, não aparecem "
"para visitantes."

#: includes/security/class-owsu-areas.php:104
msgid "Strong security keys"
msgstr "Chaves de segurança fortes"

#: includes/security/class-owsu-areas.php:104
msgid "they protect sessions and login cookies."
msgstr "protegem as sessões e os cookies de login."

#: includes/security/class-owsu-areas.php:105
msgid "Automatic core security updates on"
msgstr "Atualizações automáticas de segurança do core ativas"

#: includes/security/class-owsu-areas.php:105
msgid ""
"WordPress security fixes are applied without depending on manual action."
msgstr ""
"correções de segurança do WordPress são aplicadas sem depender de ação "
"manual."

#: includes/security/class-owsu-areas.php:110
msgid "Server"
msgstr "Servidor"

#: includes/security/class-owsu-areas.php:111
msgid ""
"Environment the site runs on: HTTPS certificate and PHP version with "
"security support."
msgstr ""
"Ambiente em que o site roda: certificado HTTPS e versão do PHP com suporte "
"de segurança."

#: includes/security/class-owsu-areas.php:112
msgid ""
"The base the site runs on: encrypted connection and a PHP version with "
"active support."
msgstr ""
"Base em que o site roda: conexão criptografada e versão de PHP com suporte "
"ativo."

#: includes/security/class-owsu-areas.php:113
msgid ""
"\"Not secure\" warnings in the browser and exposure to flaws of PHP versions"
" without support."
msgstr ""
"Avisos de site inseguro no navegador e exposição a falhas de versões de PHP "
"sem suporte."

#: includes/security/class-owsu-areas.php:115
#: includes/security/class-owsu-security.php:378
msgid "Site on HTTPS"
msgstr "Site em HTTPS"

#: includes/security/class-owsu-areas.php:115
msgid "every access to the site uses an encrypted connection."
msgstr "todo o acesso ao site usa conexão criptografada."

#: includes/security/class-owsu-areas.php:116
msgid "HTTPS with a valid certificate"
msgstr "HTTPS com certificado válido"

#: includes/security/class-owsu-areas.php:117
msgid "PHP with security support"
msgstr "PHP com suporte de segurança"

#: includes/security/class-owsu-areas.php:122
msgid "Plugins and themes"
msgstr "Plugins e temas"

#: includes/security/class-owsu-areas.php:123
msgid ""
"Components installed in WordPress: maintenance status of each item and "
"presence of unused items."
msgstr ""
"Componentes instalados no WordPress: situação de manutenção de cada item e "
"presença de itens sem uso."

#: includes/security/class-owsu-areas.php:124
msgid ""
"Each installed plugin or theme is more code to maintain. Unmaintained or "
"unused items widen the exposure without any benefit."
msgstr ""
"Cada plugin ou tema instalado é código a mais para manter. Itens sem "
"manutenção ou sem uso ampliam a exposição sem trazer benefício."

#: includes/security/class-owsu-areas.php:125
msgid "Exploitation of flaws in components that no longer receive fixes."
msgstr "Exploração de falhas em componentes que não recebem mais correções."

#: includes/security/class-owsu-areas.php:127
msgid "No known vulnerabilities"
msgstr "Sem vulnerabilidades conhecidas"

#: includes/security/class-owsu-areas.php:127
msgid ""
"the installed versions were checked against the Wordfence Intelligence "
"database."
msgstr ""
"as versões instaladas foram comparadas com a base Wordfence Intelligence."

#: includes/security/class-owsu-areas.php:128
msgid "No removed or abandoned plugins"
msgstr "Sem plugins removidos ou abandonados"

#: includes/security/class-owsu-areas.php:128
msgid ""
"no installed item stopped being maintained or was taken out of the "
"repository."
msgstr ""
"nenhum item instalado deixou de receber manutenção ou foi retirado do "
"repositório."

#: includes/security/class-owsu-areas.php:129
msgid "No installed but unused items"
msgstr "Sem itens instalados e não utilizados"

#: includes/security/class-owsu-areas.php:129
msgid "there are no idle plugins or themes in the environment."
msgstr "não há plugins ou temas parados no ambiente."

#: includes/security/class-owsu-captcha.php:53
msgid "reCAPTCHA v3 (invisible)"
msgstr "reCAPTCHA v3 (invisível)"

#: includes/security/class-owsu-captcha.php:53
msgid "reCAPTCHA v2 (\"I'm not a robot\" checkbox)"
msgstr "reCAPTCHA v2 (caixa \"Não sou um robô\")"

#: includes/security/class-owsu-captcha.php:151
msgid "please confirm you are not a robot and try again."
msgstr "confirme que você não é um robô e tente novamente."

#. translators: %s: error message
#: includes/security/class-owsu-captcha.php:168
msgid ""
"reCAPTCHA: Google did not answer (%s). Login allowed without verification."
msgstr ""
"reCAPTCHA: o Google não respondeu (%s). Login liberado sem verificação."

#. translators: %s: error message
#: includes/security/class-owsu-captcha.php:171
msgid "Could not reach Google to validate (%s)."
msgstr "Não foi possível falar com o Google para validar (%s)."

#: includes/security/class-owsu-captcha.php:180
msgid "Google rejected the verification"
msgstr "O Google recusou a verificação"

#: includes/security/class-owsu-captcha.php:180
msgid ""
"Check that the keys belong to the chosen version and that the domain is "
"registered."
msgstr ""
"Confira se as chaves são da versão escolhida e se o domínio está cadastrado."

#: includes/security/class-owsu-captcha.php:182
#: includes/security/class-owsu-captcha.php:186
msgid "the anti-robot check failed. Please try again."
msgstr "a verificação anti-robô falhou. Tente novamente."

#: includes/security/class-owsu-captcha.php:189
msgid ""
"access was blocked by the anti-robot protection. Please try again in a few "
"minutes."
msgstr ""
"o acesso foi bloqueado pela proteção anti-robô. Tente novamente em alguns "
"minutos."

#: includes/security/class-owsu-captcha.php:207
msgid "The reCAPTCHA secret key is invalid."
msgstr "A chave secreta do reCAPTCHA é inválida."

#: includes/security/class-owsu-login.php:70
msgid "The login address must have at least 4 characters."
msgstr "O endereço de login precisa ter pelo menos 4 caracteres."

#. translators: %s: login address
#: includes/security/class-owsu-login.php:74
msgid ""
"The address \"%s\" is reserved by WordPress or easy to guess. Choose another"
" one."
msgstr ""
"O endereço \"%s\" é reservado pelo WordPress ou fácil de adivinhar. Escolha "
"outro."

