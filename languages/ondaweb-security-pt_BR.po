#. Plugin Name of the plugin
#: ondaweb-update-manager.php
msgid "Ondaweb Security Updater"
msgstr "Ondaweb Security Updater"

#. Plugin URI of the plugin
#: ondaweb-update-manager.php
msgid "https://github.com/desenvolvimentoondaweb/ondaweb-security"
msgstr "https://github.com/desenvolvimentoondaweb/ondaweb-security"

#. Description of the plugin
#: ondaweb-update-manager.php
msgid ""
"Version inventory (WordPress, plugins and themes), automatic update history,"
" security checks and one-click fixes, known vulnerabilities (Wordfence "
"Intelligence), login protection and a monthly client report by email and "
"PDF. Works on single sites and multisite networks."
msgstr ""
"Inventário de versões (WordPress, plugins e temas), histórico de "
"atualizações automáticas, verificações de segurança com correção em um "
"clique, vulnerabilidades conhecidas (Wordfence Intelligence), proteção do "
"login e relatório mensal para o cliente por e-mail e PDF. Funciona em sites "
"únicos e em redes multisite."

#. Author of the plugin
#: ondaweb-update-manager.php
msgid "Ondaweb"
msgstr "Ondaweb"

#. Author URI of the plugin
#: ondaweb-update-manager.php
msgid "https://ondaweb.com.br"
msgstr "https://ondaweb.com.br"

